<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher banner for tv-hero Tools: a deep orange field with the stopwatch glyph. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FFF76B15" android:endColor="#FFB3261E" />
        </shape>
    </item>
    <item android:width="76dp" android:height="76dp" android:gravity="center"
        android:drawable="@drawable/ic_tools" />
</layer-list>
