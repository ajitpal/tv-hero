<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream, ClockActivity): an analogue watch beside the time and date, on a slow
     time-of-day gradient. The whole group drifts a little every minute so nothing burns in. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF05070C">

    <!-- The gradient is its background; clock_wallpaper puts the picture in it, cropped like Home's. -->
    <ImageView
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.ajit.tvhero.WatchFaceView
            android:id="@+id/dreamWatch"
            android:layout_width="300dp"
            android:layout_height="300dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="150dp"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="48dp"
            android:background="#33FFFFFF" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="true">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="#F2FFFFFF"
                    android:textSize="112sp"
                    android:fontFamily="@string/font_extralight"
                    android:letterSpacing="-0.03"
                    android:includeFontPadding="false" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:format12Hour="a"
                    android:format24Hour=""
                    android:textColor="#B3FFFFFF"
                    android:textSize="24sp"
                    android:fontFamily="@string/font_medium"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true" />
            </LinearLayout>

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:format12Hour="EEEE"
                android:format24Hour="EEEE"
                android:textColor="#E6FFFFFF"
                android:textSize="26sp"
                android:fontFamily="@string/font_regular"
                android:letterSpacing="0.04" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                android:format12Hour="d MMMM yyyy"
                android:format24Hour="d MMMM yyyy"
                android:textColor="#99FFFFFF"
                android:textSize="18sp"
                android:fontFamily="@string/font_regular"
                android:letterSpacing="0.16"
                android:textAllCaps="true" />

            <!-- 2.11: now and tomorrow from tv-hero's weather, when a city is set; gone otherwise. -->
            <TextView
                android:id="@+id/dreamWeather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="18dp"
                android:textColor="#D9FFFFFF"
                android:textSize="20sp"
                android:fontFamily="@string/font_regular"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Open-Meteo's data is CC BY 4.0: credited while it shows. -->
    <TextView
        android:id="@+id/dreamWeatherCredit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:textColor="#66FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
